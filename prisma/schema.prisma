generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  avatarUrl           String?
  passwordHash        String?
  completedOnboarding Boolean   @default(false)
  createdAt           DateTime  @default(now())
  projects            Project[]
}

model Project {
  id                     String       @id @default(cuid())
  name                   String
  businessType           String
  tone                   String?
  narrativeStyle         String?
  goal                   String?
  strategyRecommendation String?
  createdAt              DateTime     @default(now())
  userId                 String
  user                   User         @relation(fields: [userId], references: [id])
  platforms              Platform[]
  competitors            Competitor[]
}

model Competitor {
  id              String             @id @default(cuid())
  handle          String
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status          String             @default("idle") // idle | analyzing | done | error
  // Manual data fields
  followers       Int?
  avgLikes        Int?
  avgComments     Int?
  postsPerWeek    Float?
  contentTypes    String?            // comma-separated
  mainTopics      String?
  notes           String?
  reports         CompetitorReport[]
  createdAt       DateTime           @default(now())
  lastAnalyzedAt  DateTime?
}

model CompetitorReport {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  report       String     // JSON: CompetitorAnalysisResult
  createdAt    DateTime   @default(now())
}

model Platform {
  id         String       @id @default(cuid())
  name       String       @default("Instagram")
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hypotheses Hypothesis[]
}

model Hypothesis {
  id          String     @id @default(cuid())
  title       String
  description String
  platformId  String
  createdAt   DateTime   @default(now())
  platform    Platform   @relation(fields: [platformId], references: [id], onDelete: Cascade)
  postIdeas   PostIdea[]
}

model PostIdea {
  id                     String      @id @default(cuid())
  title                  String
  script                 String
  caption                String
  hashtags               String
  posted                 Boolean     @default(false)
  isUserCreated          Boolean     @default(false)
  recommendedPublishDate DateTime?
  scheduledPublishDate   DateTime?
  hypothesisId           String
  hypothesis             Hypothesis  @relation(fields: [hypothesisId], references: [id], onDelete: Cascade)
  result                 PostResult?
}

model PostResult {
  id            String   @id @default(cuid())
  postIdeaId    String   @unique
  views         Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  saves         Int      @default(0)
  screenshotUrl String?
  createdAt     DateTime @default(now())
  postIdea      PostIdea @relation(fields: [postIdeaId], references: [id], onDelete: Cascade)
}
