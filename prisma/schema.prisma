generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  avatarUrl           String?
  passwordHash        String?
  completedOnboarding Boolean   @default(false)
  createdAt           DateTime  @default(now())
  projects            Project[]
}

model Project {
  id                     String       @id @default(cuid())
  name                   String
  businessType           String
  tone                   String?
  narrativeStyle         String?
  goal                   String?
  strategyRecommendation String?
  createdAt              DateTime     @default(now())
  userId                 String
  user                   User         @relation(fields: [userId], references: [id])
  channels               Channel[]
  competitors            Competitor[]
}

model Competitor {
  id             String             @id @default(cuid())
  handle         String
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status         String             @default("idle")
  followers      Int?
  avgLikes       Int?
  avgComments    Int?
  postsPerWeek   Float?
  contentTypes   String?
  mainTopics     String?
  notes          String?
  reports        CompetitorReport[]
  createdAt      DateTime           @default(now())
  lastAnalyzedAt DateTime?
}

model CompetitorReport {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  report       String
  createdAt    DateTime   @default(now())
}

// Канал социальной сети (Instagram, Youtube, Threads)
// DB table: Platform (unchanged for backward compat)
model Channel {
  id        String   @id @default(cuid())
  name      String   @default("Instagram")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rubrics   Rubric[]

  @@map("Platform")
}

// Рубрика (контент-категория, бывшая Hypothesis)
// DB table: Hypothesis (unchanged)
model Rubric {
  id          String   @id @default(cuid())
  title       String
  description String
  channelId   String   @map("platformId")
  createdAt   DateTime @default(now())
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  posts       Post[]

  @@map("Hypothesis")
}

// Пост (бывший PostIdea)
// DB table: PostIdea (unchanged)
// status: DRAFT | SCHEDULED | PUBLISHED
model Post {
  id                     String      @id @default(cuid())
  title                  String
  script                 String
  caption                String
  hashtags               String
  postText               String?     // основной текст поста
  status                 String      @default("DRAFT")
  posted                 Boolean     @default(false)
  isUserCreated          Boolean     @default(false)
  recommendedPublishDate DateTime?
  scheduledPublishDate   DateTime?
  rubricId               String      @map("hypothesisId")
  rubric                 Rubric      @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  result                 PostResult?
  mediaFiles             PostMedia[]

  @@map("PostIdea")
}

model PostMedia {
  id        String   @id @default(cuid())
  postId    String   @map("postIdeaId")
  url       String
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostResult {
  id            String   @id @default(cuid())
  postId        String   @unique @map("postIdeaId")
  views         Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  saves         Int      @default(0)
  screenshotUrl String?
  createdAt     DateTime @default(now())
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}
